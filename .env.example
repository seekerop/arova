# ============================================================
# AROVA — Environment Variables
# Copy this file to .env.local for development.
# In production, set these via your hosting platform environment dashboard.
# ============================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay Subscriptions & Verification (Indian Rupee / INR)
RAZORPAY_KEY_ID=rzp_test_yourkeyid
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret

# Razorpay Subscriptions Plan IDs (OPTIONAL OVERRIDES)
# Plans are defined in code (Starter: ₹499/40 leads, Growth: ₹999/100 leads)
# The application automatically creates or caches them on Razorpay via API.
# You can leave these blank unless you want to override with pre-existing plan IDs.
RAZORPAY_STARTER_PLAN_ID=
RAZORPAY_GROWTH_PLAN_ID=

# Base URL & Durable Automation Secrets
APP_BASE_URL=http://localhost:3000
CRON_SECRET=arova_cron_secret_change_in_production
